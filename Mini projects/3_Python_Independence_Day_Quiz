def print_menu():
    print("🇮🇳======= INDEPENDENCE DAY QUIZ ======= 🇮🇳")
    print("1. Start Quiz")
    print("2. Exit")
    choice = input("Enter your choice (1/2): ").strip()
    return choice


def questions():
    quiz_questions = [
        {
            "question": "When is India's Independence Day celebrated?",
            "options": ["A. 26 January", "B. 15 August", "C. 14 November", "D. 2 October"],
            "correct_answer": "B"
        },
        {
            "question": "In which year did India gain independence from British rule?",
            "options": ["A. 1945", "B. 1947", "C. 1950", "D. 1965"],
            "correct_answer": "B"
        },
        {
            "question": "Who was the first Prime Minister of India?",
            "options": ["A. Jawaharlal Nehru", "B. Mahatma Gandhi", "C. Sardar Vallabhbhai Patel", "D. Indira Gandhi"],
            "correct_answer": "A"
        },
        {
            "question": "Where is the Red Fort located?",
            "options": ["A. Mumbai", "B. Delhi", "C. Kolkata", "D. Chennai"],
            "correct_answer": "B"
        },
        {
            "question": "How many states are there in India?",
            "options": ["A. 28", "B. 29", "C. 30", "D. 31"],
            "correct_answer": "A"
        }
    ]
    return quiz_questions
def start_quiz():
    user_name = input("\nEnter your name: ").strip().title()

    score = 0
    quiz_questions = questions()

    print(f"\n🇮🇳 Welcome {user_name}! Let's start the quiz. 🇮🇳\n")

    for number, question in enumerate(quiz_questions, start=1):

        print(f"\nQuestion {number}: {question['question']}")

        for option in question["options"]:
            print(option)

        user_answer = input(
            "Enter your answer (A/B/C/D): "
        ).strip().upper()

        if user_answer == question["correct_answer"]:
            print("✅ Correct!")
            score += 1
        else:
            print(
                "❌ Wrong! The correct answer is:",
                question["correct_answer"]
            )

    return user_name, score


def main():
    total_questions = len(questions())

    while True:

        choice = print_menu()

        if choice == "1":

            user_name, score = start_quiz()

            percentage = (score / total_questions) * 100

            print("\n🇮🇳 ===== QUIZ COMPLETED ===== 🇮🇳")
            print(f"Name: {user_name}")
            print(f"Score: {score}/{total_questions}")
            print(f"Percentage: {percentage:.2f}%")

            if score == total_questions:
                print("🏆 Outstanding! Perfect score!")
            elif score >= 3:
                print("🎉 Excellent! Good job!")
            elif score >= 2:
                print("👍 Good effort! Keep learning!")
            else:
                print("📚 Keep practicing and try again!")

            print("🇮🇳 Jai Hind! 🇮🇳")

        elif choice == "2":
            print("\n🇮🇳 Thank you for participating!")
            print("Jai Hind! 🇮🇳")
            break

        else:
            print("\n❌ Invalid choice. Please enter 1 or 2.")


if __name__ == "__main__":
    main()