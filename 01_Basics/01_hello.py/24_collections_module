#defualtdict() - Automatic defualt values
from collections import defaultdict
marks = defaultdict(int)
marks["python"] += 10
marks["python"] += 20
marks["DSA"] += 30
marks["DSA"] += 10
print(marks)


from collections import defaultdict
students = [
    ("Shravya", "CSE"),
    ("Kavya", "ECE"),
    ("Bhavya", "CSE"),
    ("Nisha", "ECE"),
    ("Ramya", "ISE")
]
