#Student Marks Analyzer 
from collections import Counter, deque, namedtuple, defaultdict

students = []

n = int(input("How many students? "))

Student = namedtuple("Student", ["name", "grade"])

for i in range(n):
    name = input(f"Enter student name {i + 1}: ").strip().title()
    grade = input(f"Enter grade for {name}: ").strip().upper()

    student = Student(name, grade)
    students.append(student)

# Counter
grades = [student.grade for student in students]
grade_count = Counter(grades)

print("\nGrade Count:")
print(grade_count)

# deque
student_queue = deque(students)

print("\nStudent Queue:")
for student in student_queue:
    print("-", student.name, ":", student.grade)

# defaultdict
groups = defaultdict(list)

for student in students:
    groups[student.grade].append(student.name)

print("\nStudents Grouped By Grade:")

for grade, names in groups.items():
    print(grade, ":", ", ".join(names))
