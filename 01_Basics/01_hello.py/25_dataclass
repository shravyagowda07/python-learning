#student record manager
from dataclasses import dataclass

@dataclass
class Student:
    name: str
    branch: str
    marks: float

def student_record_manager():
    num_students = int(input("How many students? "))
    students = []

    for i in range(num_students):
        print(f"\nEnter details for Student {i + 1}:")
        name = input("Name: ")
        branch = input("Branch: ")
        marks = float(input("Marks: "))
        
        student = Student(name=name, branch=branch, marks=marks)
        students.append(student)

    if not students:
        print("\nNo student records added.")
        return

    # Display all students
    print("\n--- Student Records ---")
    for s in students:
        print(f"Name: {s.name} | Branch: {s.branch} | Marks: {s.marks}")

    # highest marks
    top_student = max(students, key=lambda s: s.marks)
    print(f"\nHighest Marks: {top_student.name} with {top_student.marks} marks")

    # average marks
    average_marks = sum(s.marks for s in students) / len(students)
    print(f"Average Marks: {average_marks:.2f}")
if __name__ == "__main__":
    student_record_manager()