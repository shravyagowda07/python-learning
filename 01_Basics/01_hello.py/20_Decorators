#calculation decorator
def log_calculation(function):
    def wrapper(*args,**kwargs):
        print("Calculation Started")
        return function(*args,**kwargs)
    return wrapper

@log_calculation
def add(a, b):
    return a + b
print("Result:", add(5,3))


#login required decorator
from functools import wraps
current_user = {"username": "Alice", "is_logged_in": True}
def login_required(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        if current_user.get("is_logged_in"):
            return func(*args, **kwargs)
        else:
            print("Access Denied: You must be logged in to perform this action.")
            return None
    return wrapper

@login_required
def view_dashboard():
    print(f"Welcome to your dashboard, {current_user['username']}!")
view_dashboard()
current_user["is_logged_in"] = False
view_dashboard()