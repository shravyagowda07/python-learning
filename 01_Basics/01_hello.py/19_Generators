#Generators
def count_numbers():
    for i in range(1,6):
        yield i
for number in count_numbers():
    print("Numbers:",number)

#Even number generator
def even_numbers():
    for i in range(1,21):
        if i % 2 == 0:
            yield i
for number in even_numbers():
    print("Even numbers:", number)


#Student marks generator
def student_marks():
    marks = [10,304,55.89]
    for mark in marks:
        yield mark
for mark in student_marks():
    print("Student mark:", mark)

#water bottle generator
def water_bottle():
    waters = ["water 1","water 2","water 3","water 4","water 5"]
    for water in waters:
        yield water
for water in water_bottle():
    print("Need water:", water)

#Square generator
def square_numbers():
    for i in range(1,11):
            yield i ** 2
for number in square_numbers():
    print("Square numbers:", number)


#Fibonacci numbers using generator
def fibonacci_numbers():
    a, b = 0, 1
    while True:
        yield a
        a, b = b, a + b
for number in fibonacci_numbers():
    print("Fibonacci Number:",number)
    if number > 10:
        break

