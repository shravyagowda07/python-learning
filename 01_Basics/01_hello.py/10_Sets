#College Club Registration
unique_students = []
students = set()
for i in range(5):
    name = input("Enter name: ")
    if name not in students:
        students.add(name)
        unique_students.append(name)
    print("\nUnique Students:")
    for name in students:
        print(name)
print(f"\nTotal = {len(students)}")


#student Club
python_club = {"John", "Amit", "Priya", "Rahul"}
AI_club = {"Dora", "Krishna", "Ram", "Seeta"}
print("Students in both clubs:", python_club & AI_club)     #Intersection &
print("Students only in python clubs:", python_club - AI_club)
print("Students only in AI clubs:", AI_club - python_club)    #Difference -
print("All students:", python_club | AI_club)   #union is |


