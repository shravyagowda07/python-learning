# Arithmetic Operator
a = 10
b = 20
print("Adition", a + b)
print("Multiplication", a * b)
print("Substraction", a - b)
print("Division", a / b)
print("Floor Division", a // b)
print("Modulus", a % b)
print("Exponenet", a ** b)

# Comparision Operators
x = 38
y = 60
print(x == y)
print(x != y)
print(x < y)
print(x > y)
print(x <= y)
print(x >= y)

# Assignment Operator
p = 50
p += 4
print(p)
p -= 7
print(p)
p *= 5
print(p)
p /= 10
print(p)

# Logical Operator
q = True
r = False
print(q and r)
print(q or r)
print(not r)

# Membership Operator
fruits = ["apple", "banana", "mango"]
print("apple" in fruits)
print("mango" not in fruits)

#Identity Operators
z = [1,2,3]
y = z
x = [1,2,3]
print(z is y)
print(z is x)
print(z == x)

